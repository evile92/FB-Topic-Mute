{
  "manifest_version": 3,
  "name": "FB Topic Mute",
  "version": "1.0.0",
  "description": "Hide Facebook feed posts containing your muted words or phrases with full Arabic and English support.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FB Topic Mute",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "utils/textNormalizer.js",
        "content/selectors.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
